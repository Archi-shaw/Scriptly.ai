# Copy to .env.local (development) or set in your hosting provider (production).
# Never commit real secrets.

# ── Core (required) ───────────────────────────────────────────────────────────
# MongoDB connection string (Atlas recommended). MONGODB_URL is accepted as a fallback name.
MONGODB_URI=mongodb://127.0.0.1:27017/scriptly
# Public base URL of the app (used for auth callbacks and email links).
NEXTAUTH_URL=http://localhost:3000
# Long random secret for session encryption and OTP hashing. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ── AI generation (required for generating content) ─────────────────────────
OPENAI_API_KEY=
# Default: gpt-6-luna (OpenAI's listed replacement for gpt-4o-mini, which shuts down 2027-01-14).
OPENAI_MODEL=gpt-6-luna
# Default: none (no hidden reasoning — faster, cheaper, nothing eaten from the output budget).
# Use low|medium|high for more deliberate output, or "auto" to omit the parameter entirely.
OPENAI_REASONING_EFFORT=none
# Optional: any OpenAI-compatible endpoint (gateway / proxy).
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_MS=90000

# ── Email via SMTP (required in production) ──────────────────────────────────
# In development without SMTP, verification codes are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Scriptly.ai <no-reply@yourdomain.com>"
# SMTP_SECURE=false        # defaults to true only for port 465 (implicit TLS)
# SMTP_REQUIRE_TLS=true    # default in production: refuse to send unless STARTTLS succeeds

# ── Credits ───────────────────────────────────────────────────────────────────
# Free credits granted when an account is created (email signup or Google).
SIGNUP_BONUS_CREDITS=25

# ── Payments via Razorpay (optional; purchases are disabled when unset) ──────
# Use rzp_test_* keys for test mode. The webhook secret is set in the Razorpay dashboard.
# Webhook URL: https://<your-domain>/api/webhooks/razorpay — events: payment.captured, payment.failed,
# order.paid, refund.created, refund.processed, refund.failed. Keep automatic capture on.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Bot check: Cloudflare Turnstile (recommended in production) ─────────────
# Protects signup, login and forgot-password. Set BOTH or neither (one alone is refused).
# Read at runtime (no rebuild needed). Never use Cloudflare's test keys in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Content-Security-Policy (optional) ───────────────────────────────────────
# HTTPS endpoint for violation reports, and "true" to report without blocking (cautious rollout only).
# CSP_REPORT_URI=
# CSP_REPORT_ONLY=false

# ── Google sign-in (optional; the button only appears when both are set) ─────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Misc (optional) ───────────────────────────────────────────────────────────
# Inlined at BUILD time (NEXT_PUBLIC_): set it before `npm run build`.
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
# OTP_TTL_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_SENDS=5
# SESSION_MAX_AGE_DAYS=7
# AI_PROVIDER=openai

# ── Optional aliases (only if your platform already uses these names) ────────
# APP_URL=        # public URL for metadata/links; defaults to NEXTAUTH_URL
# AUTH_SECRET=    # accepted instead of NEXTAUTH_SECRET
# MONGODB_URL=    # legacy name accepted instead of MONGODB_URI
